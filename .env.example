# Lead form: the Google Apps Script web app URL (ends in /exec).
# Copy this file to .env.local for the dev server; set the same variable
# in Cloudflare Pages -> Settings -> Environment variables for the live site.
VITE_LEAD_ENDPOINT=

# Portfolio videos: the R2 bucket's public address (ends with /).
# Set it in .env.local before building; without it Our work shows sample cards.
VITE_MEDIA_BASE=
