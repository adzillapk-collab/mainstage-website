# Cloudflare cache rules: how long a visitor's browser keeps each file.
# The page itself (/, /terms.html, ...) keeps Cloudflare's default, so new uploads show straight away.

# Code and styles: their names change on every build, so they can be kept for good
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts, hero clips and photos keep their names, so a week (then quietly refreshed)
/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/hero/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/how/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/team/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/favicon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
